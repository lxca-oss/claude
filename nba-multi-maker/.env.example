# Copy this file to .env and paste your key from https://the-odds-api.com
ODDS_API_KEY=

# Bookmaker key on The Odds API (Sportsbet = sportsbet)
BOOKMAKER=sportsbet

# Markets fetched when you click a game. Each market costs roughly 1 API credit
# per request, so remove some if you're on the free 500-credit plan.
EVENT_MARKETS=h2h,spreads,totals,alternate_spreads,alternate_totals,player_points,player_rebounds,player_assists,player_threes,player_points_rebounds_assists

# How long to reuse fetched odds before asking the API again (saves credits)
CACHE_MINUTES=10

PORT=3000

# Set to 1 to use made-up sample games instead of the real API
DEMO=0
